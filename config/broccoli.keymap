// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
         &kp Q             &kp W               &kp E           &kp R           &kp T    &kp Y  &kp U            &kp I               &kp O                &kp P
&kp ESC  &kp A             &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_GUI F  &kp G    &kp H  &mt RIGHT_GUI J  &hmr_r RIGHT_ALT K  &mt RIGHT_CONTROL L  &lt 3 SEMICOLON        &kp BACKSPACE
&kp TAB  &mt LEFT_SHIFT Z  &kp X               &kp C           &kp V           &kp B    &kp N  &kp M            &kp COMMA           &kp DOT              &mt RIGHT_SHIFT SLASH  &lt 4 CAPSLOCK
                                               &kp LEFT_GUI    &lt 1 SPACE                     &lt 2 ENTER
            >;
        };

        Number {
            bindings = <
        &kp F1     &kp F2    &kp F3    &kp F4    &kp F5       &kp F6     &kp F7                &kp F8       &kp F9         &kp F10
&trans  &kp N1     &kp N2    &kp N3    &kp N4    &kp N5       &kp N6     &kp N7                &kp N8       &kp N9         &kp N0             &trans
&trans  &kp GRAVE  &kp LBKT  &kp RBKT  &kp BSLH  &kp MINUS    &kp EQUAL  &kp NON_US_BACKSLASH  &kp INT_YEN  &kp LG(MINUS)  &kp LG(LS(EQUAL))  &trans
                             &trans    &trans                            &trans
            >;
        };

        Arrows {
            bindings = <
           &kp PLUS   &kp N8  &kp N9  &kp N0  &kp ASTERISK    &kp LC(LEFT_ARROW)    &kp LEFT              &kp UP_ARROW    &kp RIGHT         &kp LC(RIGHT)
&kp EQUAL  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp FSLH        &kp LG(MINUS)         &kp LC(DOWN)          &kp DOWN_ARROW  &kp LC(UP_ARROW)  &kp LG(LS(EQUAL))  &trans
&kp COMMA  &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp K_MUTE      &kp C_VOL_DN      &kp C_VOLUME_UP    &trans
                              &trans  &trans                                        &trans
            >;
        };

        Device {
            bindings = <
       &none  &none  &none   &none   &none    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none   &none   &none    &none         &none           &none         &none         &trans        &bt BT_CLR
&none  &none  &none  &none   &none   &none    &none         &none           &none         &none         &bootloader   &bt BT_CLR_ALL
                     &trans  &trans                         &studio_unlock
            >;
        };

        layer4 {
            bindings = <
       &kp LA(LC(E))  &kp LA(LC(R))  &kp LA(LC(T))  &kp LA(LC(U))         &kp LA(LC(I))           &kp PLUS   &kp N7  &kp N8  &kp N9  &kp ASTERISK
&none  &kp LA(LC(D))  &kp LA(LC(F))  &kp LA(LC(G))  &kp LA(LC(J))         &kp LA(LC(K))           &kp MINUS  &kp N4  &kp N5  &kp N6  &kp FSLH      &kp EQUAL
&none  &none          &none          &none          &kp LG(LS(NUMBER_3))  &kp LS(LG(NUMBER_4))    &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT       &none
                                     &trans         &trans                                                   &trans
            >;
        };

        game {
            bindings = <
           &kp Q  &kp W  &kp E     &kp R      &kp T    &kp Y  &kp U  &kp I      &kp O    &kp P
&kp LCTRL  &kp A  &kp S  &kp D     &kp F      &kp G    &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp BSPC  &kp SPACE                  &to 0
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        Eisu {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <24 25>;
            layers = <0>;
            timeout-ms = <30>;
        };

        Kana {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <30 31>;
            layers = <0>;
            timeout-ms = <30>;
        };

        LeftClick {
            bindings = <&mkp LCLK>;
            key-positions = <17 18>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <30>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <18 19>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <30>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <19 17>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <30>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        Escape {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        DoubleQuote {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <7 8>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        Semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 7>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        Colon {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <29 30>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        Scroll {
            bindings = <&mo 3>;
            key-positions = <17 18 19>;
            layers = <0>;
        };

        Escape_Game {
            bindings = <&kp ESCAPE>;
            key-positions = <10 22>;
            layers = <5>;
        };

        Toggle_Game_Layer {
            bindings = <&to 5>;
            key-positions = <10 22 35>;
        };
    };

    behaviors {
        auto_caps_word: auto_caps_word {
            compatible = "zmk,behavior-auto-caps-word";
            #binding-cells = <0>;
            continue-list = <INT1 BACKSPACE DELETE>;
            display-name = "Auto Caps Word";
            auto-activate-upper-count = <3>;
        };

        hmr_l: hmr_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 32 33 28 29 19 18 17 16 6 7 8 9 20 21 30 31>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            hold-trigger-key-positions = <22 23 24 14 13 12 11 10 0 1 2 3 4 15 25 26 27>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        lt_arrow: lt_arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ARROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        lt_scroll: lt_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLL";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;

            hold-while-undecided;
            require-prior-idle-ms = <150>;
        };

        hmr_l_2: hmr_l_2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_L_2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 32 33 28 29 19 18 17 16 6 7 8 9 21 20 31 30>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
        };

        hmr_r_2: hmr_r_2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R_2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            hold-trigger-key-positions = <22 23 24 14 13 12 11 10 0 1 2 3 4 25 26 27 15>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
        };

        hmr_num_l: hmr_num_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_NUM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 32 33 28 29 19 18 17 16 6 7 8 9 20 21 30 31>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        hmr_num_r: hmr_num_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_NUM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <22 23 24 14 13 12 11 10 0 1 2 3 4 25 26 27 15>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            retro-tap;
        };
    };
};

&trackball_listener {
    input-processors = <&zip_xy_swap_mapper &zip_xy_transform INPUT_TRANSFORM_X_INVERT>;

    scroller {
        layers = <3>;
        input-processors = <&zip_xy_swap_mapper &zip_xy_transform INPUT_TRANSFORM_X_INVERT &zip_xy_to_scroll_mapper &zip_scroll_scaler 1 16>;
    };
};
