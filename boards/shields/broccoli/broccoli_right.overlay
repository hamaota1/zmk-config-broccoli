// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more
// instructions.

#include "broccoli.dtsi"

&default_transform {
    // Set this to the number of columns on the left side.
    col-offset = <5>;
};

&kscan {
    // Replace these comments with the GPIO pins in the matrix for the right side.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#shield-overlays
    col-gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH>
        , <&xiao_d 1 GPIO_ACTIVE_HIGH>
        , <&xiao_d 2 GPIO_ACTIVE_HIGH>
        , <&xiao_d 3 GPIO_ACTIVE_HIGH>
        , <&xiao_d 6 GPIO_ACTIVE_HIGH>
        ;
    row-gpios
        = <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

&uicr {
    nfct-pins-as-gpios;
};

&spi0 {
    status = "okay";
};

&trackball {
    status = "okay";
};

&trackball_split {
    device = <&trackball>;
};

/* クリック操作などでAMLから抜けないように除外キーを設定 */
&zip_temp_layer {
    /* マウスクリック（J, L）を配置するキーのポジション番号を指定 */
    excluded-positions = <16 18>; 
};

&trackball_listener {
    input-processors = <&zip_temp_layer 5 2000>;
};

#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    input-processors = <&zip_temp_layer 5 2000>;

    /* スクロールレイヤーの設定（例: レイヤー6） */
    scroll_layer {
        layers = ;
        input-processors = 
            <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_scaler 1 3>; /* 必要に応じてスクロール速度を1/3に減速 */
    };
};
